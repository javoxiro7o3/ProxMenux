# Copy to secrets/smtp.env, chmod 600, fill in the values from the SMTP partner.
SMTP_HOST=mail.internal.example
SMTP_PORT=587
# on|off
SMTP_TLS=on
SMTP_STARTTLS=on
SMTP_AUTH=on
SMTP_USER=netdata
SMTP_PASSWORD=change-me
# Internal CA certificate of the SMTP server (empty = system trust store)
SMTP_CA_FILE=
SMTP_FROM=netdata@internal.example
# Space separated recipients
SMTP_TO="admin1@internal.example admin2@internal.example"
